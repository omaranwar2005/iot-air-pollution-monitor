# Copy these into Railway Environment Variables

PORT=5000
NODE_ENV=production

# MongoDB Atlas (free) - create at mongodb.com/atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/iot_air_pollution

# JWT
JWT_SECRET=iot_air_pollution_super_secret_jwt_key_2024_railway
JWT_EXPIRE=7d

# MQTT - public broker (no auth needed)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_WS_URL=ws://broker.hivemq.com:8000
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=railway_backend_001

# Frontend URL
FRONTEND_URL=https://your-railway-url.railway.app
