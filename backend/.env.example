# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/iot_air_pollution

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:9001
MQTT_USERNAME=iotuser
MQTT_PASSWORD=iotpassword
MQTT_CLIENT_ID=backend_server

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=IoT Monitor <your_email@gmail.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Alert Thresholds
CO2_WARNING=1000
CO2_DANGER=2000
SMOKE_WARNING=200
SMOKE_DANGER=400
NH3_WARNING=25
NH3_DANGER=50
BENZENE_WARNING=5
BENZENE_DANGER=10
ALCOHOL_WARNING=200
ALCOHOL_DANGER=500
TEMP_WARNING=35
TEMP_DANGER=45
HUMIDITY_WARNING=70
HUMIDITY_DANGER=90
